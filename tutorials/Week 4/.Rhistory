y <- c(105, 69, 86, 100, 82, 111, 104, 110, 87, 108,
87, 90, 94, 113, 112, 98, 80, 97, 95, 111,
114, 89, 95, 126, 98)
n <- length(y)
xbar <- mean(y)
s <- sd(y)
se <- s / sqrt(n)
tcrit90 <- qt(0.95, df = n - 1)
lower90 <- xbar - tcrit90 * se
upper90 <- xbar + tcrit90 * se
tstat <- (xbar - 100) / se
pvalue <- pt(tstat, df = n - 1, lower.tail = FALSE)
t.test(y, mu = 100, alternative = "greater")
